#!/usr/bin/env bash
# bin/sandbox-build-ami — bake a fresh AMI.

set -euo pipefail

REPO_ROOT="${SANDBOX_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
# shellcheck source=../lib/log.sh
source "$REPO_ROOT/lib/log.sh"
# shellcheck source=../lib/config.sh
source "$REPO_ROOT/lib/config.sh"
# shellcheck source=../lib/provider.sh
source "$REPO_ROOT/lib/provider.sh"

usage() {
    cat <<'EOF'
Usage: sandbox build-ami [--cloud aws|gcp]

Bake a fresh image for the active cloud (CLOUD in ./config, or --cloud). Both
run the same ami/bootstrap.sh (installs node, uv, docker, nvim, gh, shellcheck,
bats, etc.; clones claude-hardening + DOTFILES_REPO if set). ~5-10 min.

  AWS: t3.medium from the latest Ubuntu 24.04 amd64 AMI -> create an AMI ->
       write AMI_ID into ./config, terminate the bake VM.
  GCP: e2-medium from ubuntu-2404-lts-amd64 -> stop the VM -> create a custom
       image (family claude-sandbox) -> write GCP_IMAGE into ./config, delete
       the bake VM + firewall.

On failure the bake VM is left up with a debug SSH command and a teardown hint.
EOF
}

CLOUD_FLAG=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --cloud)
            case "${2:-}" in aws|gcp) ;; *) die "unknown --cloud '${2:-}' (supported: aws, gcp)" ;; esac
            CLOUD_FLAG="$2"; shift 2 ;;
        *) die "unknown arg: $1 (try 'sandbox build-ami --help')" ;;
    esac
done

config_load
[[ -n "$CLOUD_FLAG" ]] && config_set_from_flag CLOUD "$CLOUD_FLAG"
provider_load
provider_build_image
