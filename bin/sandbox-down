#!/usr/bin/env bash
# bin/sandbox-down — terminate one sandbox, all of them, or stale ones, across
# BOTH clouds (aws + gcp). --cloud narrows to one; --all/--stale prompt for
# confirmation (--yes skips).

set -euo pipefail

REPO_ROOT="${SANDBOX_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
# shellcheck source=../lib/log.sh
source "$REPO_ROOT/lib/log.sh"
# shellcheck source=../lib/config.sh
source "$REPO_ROOT/lib/config.sh"
# shellcheck source=../lib/multicloud.sh
source "$REPO_ROOT/lib/multicloud.sh"

usage() {
    cat <<'EOF'
Usage: sandbox down <name> [--cloud aws|gcp]
       sandbox down --all [--cloud aws|gcp] [--yes]
       sandbox down --stale <duration> [--cloud aws|gcp] [--yes]   # e.g. 30m, 24h, 2d

Finds and terminates sandboxes across BOTH clouds. `down <name>` terminates that
one box wherever it lives. `--all` / `--stale` first list what they'd terminate
and ask for confirmation; `--yes` skips the prompt. `--cloud aws|gcp` restricts
any of these to a single cloud.
EOF
}

# parse_duration_to_seconds 24h | 30m | 2d
parse_duration_to_seconds() {
    local d="$1"
    [[ "$d" =~ ^([0-9]+)([smhd])$ ]] || die "bad duration: $d (use 30m, 24h, 2d, etc.)"
    local n="${BASH_REMATCH[1]}" u="${BASH_REMATCH[2]}"
    case "$u" in
        s) echo "$n" ;;
        m) echo $(( n * 60 )) ;;
        h) echo $(( n * 3600 )) ;;
        d) echo $(( n * 86400 )) ;;
    esac
}

scope=""
assume_yes=0
mode=""
dur=""
target=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --cloud)   [[ $# -ge 2 ]] || die "--cloud needs a value (aws|gcp)"
                   scope="$2"; mc_valid_cloud "$scope"; shift 2 ;;
        --cloud=*) scope="${1#*=}"; mc_valid_cloud "$scope"; shift ;;
        -y|--yes)  assume_yes=1; shift ;;
        --all)     [[ -n "$mode" ]] && die "pick one of <name> / --all / --stale"
                   mode="all"; shift ;;
        --stale)   [[ -n "$mode" ]] && die "pick one of <name> / --all / --stale"
                   [[ $# -ge 2 ]] || die "--stale needs a duration (e.g. 24h)"
                   mode="stale"; dur="$2"; shift 2 ;;
        -*)        die "unknown flag: $1 (try 'sandbox down --help')" ;;
        *)         [[ -n "$mode" ]] && die "pick one of <name> / --all / --stale"
                   mode="one"; target="$1"; shift ;;
    esac
done
[[ -z "$mode" ]] && { usage >&2; exit 2; }

config_load

# confirm_bulk SEL — print the boxes in SEL (10-field rows) and require y/yes
# unless --yes. Aborts the whole command (exit 0) if not confirmed.
confirm_bulk() {
    local sel="$1" count reply=""
    count="$(printf '%s\n' "$sel" | grep -c .)"
    {
        printf '\nThese %s sandbox(es) will be TERMINATED:\n\n' "$count"
        printf '%s\n' "$sel" | awk -F'\t' '{printf "  %-4s %-24s %s\n", $1, $3, $4}'
        printf '\n'
    } >&2
    [[ "$assume_yes" -eq 1 ]] && return 0
    printf 'Proceed? [y/N] ' >&2
    read -r reply || true
    case "$reply" in
        y|Y|yes|YES) return 0 ;;
        *) log_info "aborted — nothing terminated"; exit 0 ;;
    esac
}

sel=""
case "$mode" in
    all)
        rows="$(provider_list_all "$scope")"
        sel="$(printf '%s\n' "$rows" | awk -F'\t' '$1!="" && $4!="shutting-down" && $4!="terminated"')"
        [[ -z "$sel" ]] && { log_info "no sandboxes to terminate"; exit 0; }
        confirm_bulk "$sel"
        ;;
    stale)
        threshold_sec="$(parse_duration_to_seconds "$dur")"
        now="$(date -u +%s)"
        rows="$(provider_list_all "$scope")"
        # Older than the threshold (by launch_epoch, field 7), excluding rows
        # already shutting down/terminated.
        sel="$(printf '%s\n' "$rows" | awk -F'\t' -v now="$now" -v thr="$threshold_sec" \
            '$1!="" && $4!="shutting-down" && $4!="terminated" && (now-$7)>=thr')"
        [[ -z "$sel" ]] && { log_info "no stale sandboxes"; exit 0; }
        confirm_bulk "$sel"
        ;;
    one)
        # Find the box by name or handle across clouds (dies on none/ambiguous).
        sel="$(mc_find "$target" "$scope")"
        state="$(printf '%s' "$sel" | awk -F'\t' '{print $4}')"
        case "$state" in
            shutting-down|terminated)
                # The instance is gone, but its per-sandbox SG / firewall rule is
                # not — clouds keep those after termination, and an orphan blocks
                # `up --name <same>`. Nothing to terminate, but plenty to clean up.
                log_info "$target is already $state — releasing its network resources"
                printf '%s\n' "$sel" | awk -F'\t' '{print $1"\t"$3}' | mc_cleanup_net
                exit 0 ;;
        esac
        log_info "terminating $target — track via './bin/sandbox list'"
        ;;
esac

# Feed "provider<TAB>handle<TAB>name" to the grouped terminator.
printf '%s\n' "$sel" | awk -F'\t' '{print $1"\t"$2"\t"$3}' | mc_terminate
