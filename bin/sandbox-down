#!/usr/bin/env bash
# bin/sandbox-down — terminate one sandbox, all of them, or stale ones.

set -euo pipefail

REPO_ROOT="${SANDBOX_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
# shellcheck source=../lib/log.sh
source "$REPO_ROOT/lib/log.sh"
# shellcheck source=../lib/config.sh
source "$REPO_ROOT/lib/config.sh"
# shellcheck source=../lib/provider.sh
source "$REPO_ROOT/lib/provider.sh"

usage() {
    cat <<'EOF'
Usage: sandbox down <name|id>
       sandbox down --all
       sandbox down --stale <duration>   # e.g. 30m, 24h, 2d
EOF
}

# Early --help check (before config / provider calls), so help works even
# when credentials aren't loaded.
case "${1:-}" in
    -h|--help) usage; exit 0 ;;
esac

config_load
provider_load
provider_check_creds

# parse_duration_to_seconds 24h | 30m | 2d
parse_duration_to_seconds() {
    local d="$1"
    [[ "$d" =~ ^([0-9]+)([smhd])$ ]] || die "bad duration: $d (use 30m, 24h, 2d, etc.)"
    local n="${BASH_REMATCH[1]}" u="${BASH_REMATCH[2]}"
    case "$u" in
        s) echo "$n" ;;
        m) echo $(( n * 60 )) ;;
        h) echo $(( n * 3600 )) ;;
        d) echo $(( n * 86400 )) ;;
    esac
}

if [[ $# -eq 0 ]]; then usage; exit 2; fi

mode="$1"

# rows: handle name state type market launch_epoch ip allowed_cidr ash_hours
rows="$(provider_list)"

select_ids=()
select_names=()

case "$mode" in
    --all)
        # Every row that isn't already shutting-down/terminated.
        while IFS=$'\t' read -r h n s _type _mkt _launch _ip _cidr _ash; do
            [[ -z "$h" ]] && continue
            case "$s" in
                shutting-down|terminated) continue ;;
            esac
            select_ids+=("$h")
            select_names+=("$n")
        done <<< "$rows"
        if [[ ${#select_ids[@]} -eq 0 ]]; then
            log_info "no sandboxes to terminate"
            exit 0
        fi
        log_info "shutting down: ${select_ids[*]} — track via './bin/sandbox list'"
        ;;
    --stale)
        [[ $# -lt 2 ]] && { usage; exit 2; }
        threshold_sec="$(parse_duration_to_seconds "$2")"
        now="$(date -u +%s)"
        # Rows older than the threshold, excluding ones already shutting
        # down/terminated. Staleness keys off launch_epoch (LaunchTime-
        # derived) rather than a CreatedAt tag — in practice CreatedAt ==
        # launch time, so this is behavior-preserving in the field.
        while IFS=$'\t' read -r h n s _type _mkt launch _ip _cidr _ash; do
            [[ -z "$h" ]] && continue
            case "$s" in
                shutting-down|terminated) continue ;;
            esac
            age=$(( now - launch ))
            if (( age >= threshold_sec )); then
                select_ids+=("$h")
                select_names+=("$n")
            fi
        done <<< "$rows"
        if [[ ${#select_ids[@]} -eq 0 ]]; then
            log_info "no stale sandboxes"
            exit 0
        fi
        log_info "shutting down stale: ${select_ids[*]} — track via './bin/sandbox list'"
        ;;
    -*)
        usage; exit 2 ;;
    *)
        # Single name or handle.
        target="$mode"
        match_id=""
        match_name=""
        match_state=""
        while IFS=$'\t' read -r h n s _type _mkt _launch _ip _cidr _ash; do
            [[ -z "$h" ]] && continue
            if [[ "$n" == "$target" || "$h" == "$target" ]]; then
                match_id="$h"
                match_name="$n"
                match_state="$s"
                break
            fi
        done <<< "$rows"
        if [[ -z "$match_id" ]]; then
            die "no sandbox named $target"
        fi
        case "$match_state" in
            shutting-down|terminated)
                log_info "$target ($match_id) is already $match_state — nothing to do"
                exit 0
                ;;
        esac
        log_info "shutting down $target ($match_id) — track via './bin/sandbox list'"
        select_ids=("$match_id")
        select_names=("$match_name")
        ;;
esac

provider_terminate_ids "${select_ids[@]}"
provider_cleanup_net "${select_names[@]}"
