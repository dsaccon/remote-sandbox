#!/usr/bin/env bash
# bin/sandbox-down — terminate one sandbox, all of them, or stale ones.

set -euo pipefail

REPO_ROOT="${SANDBOX_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
# shellcheck source=../lib/log.sh
source "$REPO_ROOT/lib/log.sh"
# shellcheck source=../lib/config.sh
source "$REPO_ROOT/lib/config.sh"
# shellcheck source=../lib/aws.sh
source "$REPO_ROOT/lib/aws.sh"

usage() {
    cat <<'EOF'
Usage: sandbox down <name|id>
       sandbox down --all
       sandbox down --stale <duration>   # e.g. 30m, 24h, 2d
EOF
}

# Early --help check (before config / AWS calls), so help works even
# when credentials aren't loaded.
case "${1:-}" in
    -h|--help) usage; exit 0 ;;
esac

config_load
aws_caller_identity

# parse_duration_to_seconds 24h | 30m | 2d
parse_duration_to_seconds() {
    local d="$1"
    [[ "$d" =~ ^([0-9]+)([smhd])$ ]] || die "bad duration: $d (use 30m, 24h, 2d, etc.)"
    local n="${BASH_REMATCH[1]}" u="${BASH_REMATCH[2]}"
    case "$u" in
        s) echo "$n" ;;
        m) echo $(( n * 60 )) ;;
        h) echo $(( n * 3600 )) ;;
        d) echo $(( n * 86400 )) ;;
    esac
}

iso_to_epoch() {
    local iso="${1%.*}"  # strip fractional seconds
    iso="${iso%Z}"
    date -u -j -f "%Y-%m-%dT%H:%M:%S" "$iso" "+%s" 2>/dev/null \
        || date -u -d "${iso}Z" "+%s"
}

if [[ $# -eq 0 ]]; then usage; exit 2; fi

# cleanup_sandbox_sg NAME — best-effort delete of <NAME>-sg. Per-sandbox SGs
# are named this way by `up`. Failures are silent and expected: legacy
# sandboxes share the old SG (no -sg variant exists) and freshly-terminated
# instances still hold the SG via their ENI for ~60s. Re-run `down` (or
# leave it for now) to retry.
cleanup_sandbox_sg() {
    local sb_name="$1"
    local sg_name="${sb_name}-sg"
    if _aws ec2 delete-security-group --group-name "$sg_name" 2>/dev/null; then
        log_info "deleted SG $sg_name"
    fi
}

mode="$1"
case "$mode" in
    --all)
        # Narrow filter to instances that aren't already being terminated;
        # the default helper filter now includes shutting-down, which we
        # don't want to re-terminate.
        json="$(aws_describe_instances_by_tag Project claude-sandbox \
            'pending,running,stopping,stopped')"
        ids=()
        names=()
        while IFS=$'\t' read -r line_id line_name; do
            [[ -z "$line_id" ]] && continue
            ids+=("$line_id")
            [[ -n "$line_name" ]] && names+=("$line_name")
        done < <(printf '%s' "$json" | jq -r '.Reservations[].Instances[] |
            "\(.InstanceId)\t\((.Tags // []) | map(select(.Key=="Name")) | .[0].Value // "")"')
        if [[ ${#ids[@]} -eq 0 ]]; then
            log_info "no sandboxes to terminate"
            exit 0
        fi
        log_info "shutting down: ${ids[*]} — track via './bin/sandbox list'"
        aws_terminate_instances "${ids[@]}" >/dev/null
        for n in "${names[@]}"; do cleanup_sandbox_sg "$n"; done
        ;;
    --stale)
        [[ $# -lt 2 ]] && { usage; exit 2; }
        threshold_sec="$(parse_duration_to_seconds "$2")"
        now="$(date -u +%s)"
        # Narrow filter — don't re-terminate already-shutting-down instances.
        json="$(aws_describe_instances_by_tag Project claude-sandbox \
            'pending,running,stopping,stopped')"
        # Pick instances where CreatedAt is older than threshold.
        ids=()
        names=()
        while IFS=$'\t' read -r id name; do
            [[ -z "$id" ]] && continue
            ids+=("$id")
            [[ -n "$name" ]] && names+=("$name")
        done < <(printf '%s' "$json" | jq -r '
            .Reservations[].Instances[] |
            { id: .InstanceId,
              name: ((.Tags // []) | map(select(.Key=="Name")) | .[0].Value // ""),
              created: ((.Tags // []) | map(select(.Key=="CreatedAt")) | .[0].Value // .LaunchTime) }
            | "\(.id)\t\(.name)\t\(.created)"' | while IFS=$'\t' read -r id name created; do
                created_epoch="$(iso_to_epoch "$created")"
                age=$(( now - created_epoch ))
                if (( age >= threshold_sec )); then
                    printf '%s\t%s\n' "$id" "$name"
                fi
            done)
        if [[ ${#ids[@]} -eq 0 ]]; then
            log_info "no stale sandboxes"
            exit 0
        fi
        log_info "shutting down stale: ${ids[*]} — track via './bin/sandbox list'"
        aws_terminate_instances "${ids[@]}" >/dev/null
        for n in "${names[@]}"; do cleanup_sandbox_sg "$n"; done
        ;;
    --help|-h)
        usage; exit 0 ;;
    -*)
        usage; exit 2 ;;
    *)
        # Single name or id.
        target="$mode"
        state=""
        name=""
        if [[ "$target" =~ ^i-[0-9a-f]+$ ]]; then
            id="$target"
            # Look up the name from the instance tags so we know what SG
            # to clean up. Tolerate missing name (silent — cleanup skipped).
            # Single quotes are intentional — this is a JMESPath expression for
            # the aws CLI, not a shell string meant to expand.
            # shellcheck disable=SC2016
            name="$(_aws ec2 describe-instances --instance-ids "$id" \
                --query 'Reservations[0].Instances[0].Tags[?Key==`Name`].Value | [0]' \
                --output text 2>/dev/null || true)"
            [[ "$name" == "None" ]] && name=""
        else
            # Broad filter so we can detect already-shutting-down / terminated
            # instances by name and skip the redundant terminate call.
            json="$(aws_describe_instances_by_tag Project claude-sandbox \
                'pending,running,stopping,stopped,shutting-down,terminated')"
            # Emit id + state for the first matching instance; first() avoids
            # SIGPIPE under pipefail if multiple instances share a name.
            match="$(printf '%s' "$json" | jq -r --arg n "$target" '
                first(
                    .Reservations[].Instances[] |
                    select((.Tags // []) | any(.Key=="Name" and .Value==$n)) |
                    "\(.InstanceId)\t\(.State.Name)"
                ) // empty')"
            if [[ -z "$match" ]]; then
                die "no sandbox named $target"
            fi
            IFS=$'\t' read -r id state <<< "$match"
            name="$target"
        fi
        case "$state" in
            shutting-down|terminated)
                log_info "$target ($id) is already $state — nothing to do"
                exit 0
                ;;
        esac
        log_info "shutting down $target ($id) — track via './bin/sandbox list'"
        aws_terminate_instances "$id" >/dev/null
        [[ -n "$name" ]] && cleanup_sandbox_sg "$name"
        ;;
esac
