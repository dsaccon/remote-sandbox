#!/usr/bin/env bash
# bin/sandbox — dispatcher.
# Usage: sandbox <command> [args...]
# Commands: up, down, list, ssh, scp, build-ami

set -euo pipefail

# Resolve repo root regardless of where script is invoked from.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
export SANDBOX_REPO_ROOT="$REPO_ROOT"

# shellcheck source=../lib/log.sh
source "$REPO_ROOT/lib/log.sh"

usage() {
    cat <<'EOF'
Usage: sandbox <command> [args...]
       sandbox --help

Commands:
  up [--repo URL] [--name N] [--instance-type T] [--spot|--no-spot] [--ssh-cidr CIDR]
                 Provision one ephemeral sandbox. Creates a per-sandbox SG
                 with :22 ingress from --ssh-cidr (defaults to your IP).
                 --spot/--no-spot override the USE_SPOT default for this launch.
  down <name|id> | --all | --stale <duration>
                 Terminate one sandbox, all of them, or boxes older than
                 the given duration (e.g. 30m, 24h, 2d).
  list [--active]
                 List all sandboxes (or just ready ones with --active).
  spot [on|off|status]
                 Show or set the standing spot default (USE_SPOT). `up` uses
                 it unless you pass --spot/--no-spot. Spot is cheaper but AWS
                 can reclaim (terminate) the box at any time.
  ssh <name> [--ports P [P ...]]
                 SSH into a named sandbox. --ports forwards each local port to
                 the box (ssh -L P:localhost:P).
  scp <name> <src-path> [dest-path]
                 Upload a local file or directory to a sandbox (dir → scp -r).
                 With no dest-path, navigate the remote filesystem
                 interactively to choose the destination directory.
  scp <name> -d [remote-src] [local-dest]
                 Download a file FROM a sandbox (-d / --download). With no
                 remote-src, browse the remote filesystem and pick a file;
                 local-dest defaults to the current directory.
  build-ami [--cloud aws|gcp]
                 Bake a fresh image for the active cloud; writes AMI_ID (aws)
                 or GCP_IMAGE (gcp) to ./config on success.
  list-images [--active] [--cloud aws|gcp]
                 List baked images across both clouds (AWS AMIs + GCP custom
                 images) with a PROVIDER column. CURRENT=`yes` marks the image
                 in ./config that `up` boots from. Alias: list-amis.
  delete-image [--cloud aws|gcp] [--force] <id|name> [...]
                 Delete images in whichever cloud they live in (AMI + snapshot
                 on aws, image on gcp). Refuses the current image without
                 --force. Alias: delete-ami.

Run `sandbox <command> --help` for command-specific options.

Settings (instance type, region, key pair, AMI ID, etc.) live in ./config.
EOF

    # Only nag about AWS creds when they aren't already in the environment —
    # avoids noise on `--help` after `source ./init.sh`.
    if [[ -z "${AWS_ACCESS_KEY_ID:-}" \
       || -z "${AWS_SECRET_ACCESS_KEY:-}" \
       || -z "${AWS_DEFAULT_REGION:-}" ]]; then
        cat <<'EOF'

Environment must have AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
AWS_DEFAULT_REGION set — do `source ./init.sh` in each new shell.
EOF
    fi
}

# Top-level help — must short-circuit BEFORE the config check so it works
# even when the repo isn't set up yet.
if [[ $# -eq 0 ]]; then
    usage >&2
    exit 2
fi
case "$1" in
    -h|--help|help) usage; exit 0 ;;
esac

cmd="$1"; shift

# Command aliases — cloud-neutral names are canonical; keep the old
# AMI-flavored ones working for muscle memory.
case "$cmd" in
    list-amis)  cmd="list-images" ;;
    delete-ami) cmd="delete-image" ;;
esac

# Every command needs a config to know region/etc.  Check existence here
# so error is uniform.
if [[ ! -f "$REPO_ROOT/config" ]]; then
    if [[ -f "$REPO_ROOT/config.example" ]]; then
        die "no config file at ./config — copy config.example to config and edit"
    else
        die "no config file at ./config and no config.example — repo is broken"
    fi
fi

sub="$REPO_ROOT/bin/sandbox-$cmd"
if [[ ! -x "$sub" ]]; then
    die "unknown command: $cmd (try 'sandbox --help')"
fi

exec "$sub" "$@"
