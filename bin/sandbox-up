#!/usr/bin/env bash
# bin/sandbox-up — provision one sandbox.

set -euo pipefail

REPO_ROOT="${SANDBOX_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
# shellcheck source=../lib/log.sh
source "$REPO_ROOT/lib/log.sh"
# shellcheck source=../lib/config.sh
source "$REPO_ROOT/lib/config.sh"
# shellcheck source=../lib/aws.sh
source "$REPO_ROOT/lib/aws.sh"
# shellcheck source=../lib/provision.sh
source "$REPO_ROOT/lib/provision.sh"

usage() {
    cat <<'EOF'
Usage: sandbox up [--repo URL] [--name N] [--instance-type T] [--spot|--no-spot]
                  [--ssh-cidr CIDR]

Provision one ephemeral sandbox VM and print the SSH command to reach it.

Flags:
  --repo URL          Clone this git URL onto the box during cloud-init.
  --name N            Use N as the sandbox name (default: random hex).
  --instance-type T   Override INSTANCE_TYPE from config (e.g. t3.large).
  --spot              Force a spot instance for this launch, overriding the
                      USE_SPOT config default. Cheaper, but AWS can reclaim
                      (terminate) the box at any time.
  --no-spot           Force on-demand for this launch, overriding USE_SPOT.
                      Use for sessions where a mid-task spot reclaim would be
                      especially costly. (A per-launch flag wins over config;
                      change the standing default with `sandbox spot on|off`.)
  --ssh-cidr CIDR     SG :22 ingress for this sandbox. Defaults: the
                      SSH_INGRESS_CIDR config value, or your auto-detected
                      HTTPS egress IP if unset. Use `0.0.0.0/0` to leave
                      SSH open (less secure, but unblocks split-tunnel
                      networks where HTTPS and SSH egress differ).
EOF
}

REPO_URL=""
NAME=""
SPOT_OVERRIDE=""   # "" = use config; "true" = --spot; "false" = --no-spot
SSH_CIDR_FLAG=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo)           REPO_URL="$2"; shift 2 ;;
        --name)           NAME="$2"; shift 2 ;;
        --instance-type)  config_set_from_flag INSTANCE_TYPE "$2"; shift 2 ;;
        --spot)
            [[ "$SPOT_OVERRIDE" == "false" ]] && die "conflicting --spot/--no-spot"
            SPOT_OVERRIDE="true"; shift ;;
        --no-spot)
            [[ "$SPOT_OVERRIDE" == "true" ]] && die "conflicting --spot/--no-spot"
            SPOT_OVERRIDE="false"; shift ;;
        --ssh-cidr)       SSH_CIDR_FLAG="$2"; shift 2 ;;
        -h|--help)        usage; exit 0 ;;
        *)                usage >&2; exit 2 ;;
    esac
done

config_load

# Default name = sandbox-<8 hex chars>. Use openssl rather than
# `tr ... </dev/urandom | head -c8` because under `set -o pipefail` head
# closing stdin SIGPIPEs tr → whole pipeline exits 141 → silent script death.
if [[ -z "$NAME" ]]; then
    NAME="sandbox-$(openssl rand -hex 4)"
fi

# A per-launch flag wins over the config default.
USE_SPOT_FINAL="${SPOT_OVERRIDE:-$USE_SPOT}"

preflight_or_die

ssh_cidr="$(resolve_ssh_cidr "$SSH_CIDR_FLAG")"

read -r id < <(provision_launch "$NAME" "$REPO_URL" "$USE_SPOT_FINAL" "$ssh_cidr")

if [[ "${AUTO_SHUTDOWN_HOURS:-0}" -gt 0 ]]; then
    shutdown_note="Auto-shutdown in ${AUTO_SHUTDOWN_HOURS}h."
else
    shutdown_note="Auto-shutdown disabled — terminate with \`./bin/sandbox down $NAME\`."
fi

cat <<EOF

  $NAME launching ($id)

  Returning control now. The instance moves: pending → initializing → ready,
  typically reaching ready in 60-90s. Track with:

      ./bin/sandbox list

  Once it shows 'ready', drop in:

      ./bin/sandbox ssh $NAME

  Then run \`claude\` to authenticate this VM. $shutdown_note

EOF
