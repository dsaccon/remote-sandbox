#!/usr/bin/env bash
# bin/sandbox-ssh — SSH into a named sandbox.

set -euo pipefail

REPO_ROOT="${SANDBOX_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
# shellcheck source=../lib/log.sh
source "$REPO_ROOT/lib/log.sh"
# shellcheck source=../lib/config.sh
source "$REPO_ROOT/lib/config.sh"
# shellcheck source=../lib/aws.sh
source "$REPO_ROOT/lib/aws.sh"

: "${SSH_CMD:=ssh}"

case "${1:-}" in
    -h|--help)
        cat <<'EOF'
Usage: sandbox ssh <name>

Resolve <name> to the running sandbox's public IP via EC2 tags and exec
ssh into it as $SSH_USER. The SSH key file (-i $SSH_KEY_FILE) and
IdentitiesOnly=yes are passed automatically when the file is readable.
EOF
        exit 0
        ;;
esac

[[ $# -eq 1 ]] || die "Usage: sandbox ssh <name>  (try 'sandbox ssh --help')"
name="$1"

config_load
aws_caller_identity

# Resolve <name> to the running box's public IP (shared with `scp`). Dies with
# a state-specific message if the box is missing/booting/stopped/gone.
ip="$(aws_resolve_running_sandbox_ip "$name")" || exit 1

ssh_args=()
if [[ -n "${SSH_KEY_FILE:-}" && -r "$SSH_KEY_FILE" ]]; then
    ssh_args+=(-i "$SSH_KEY_FILE" -o IdentitiesOnly=yes)
fi
# Fold the destination into the array so the expansion below is never empty —
# "${arr[@]}" on an empty array is an "unbound variable" error under `set -u`
# on bash 3.2 (the laptop default), which fires when no key file is readable.
ssh_args+=("${SSH_USER}@${ip}")

exec "$SSH_CMD" "${ssh_args[@]}"
