#!/usr/bin/env bash
# bin/sandbox-ssh — SSH into a named sandbox.

set -euo pipefail

REPO_ROOT="${SANDBOX_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
# shellcheck source=../lib/log.sh
source "$REPO_ROOT/lib/log.sh"
# shellcheck source=../lib/config.sh
source "$REPO_ROOT/lib/config.sh"
# shellcheck source=../lib/aws.sh
source "$REPO_ROOT/lib/aws.sh"

: "${SSH_CMD:=ssh}"

[[ $# -eq 1 ]] || die "Usage: sandbox ssh <name>"
name="$1"

config_load
aws_caller_identity

json="$(aws_describe_instances_by_tag Name "$name")"
# Limit inside jq (via first()) rather than `| head -n1` to avoid SIGPIPE
# under `set -o pipefail` if there's more than one running instance.
ip="$(printf '%s' "$json" | jq -r 'first(.Reservations[].Instances[] | select(.State.Name=="running") | .PublicIpAddress) // empty')"

if [[ -z "$ip" || "$ip" == "null" ]]; then
    die "no sandbox named $name (or it's not running)"
fi

ssh_args=()
if [[ -n "${SSH_KEY_FILE:-}" && -r "$SSH_KEY_FILE" ]]; then
    ssh_args+=(-i "$SSH_KEY_FILE" -o IdentitiesOnly=yes)
fi

exec "$SSH_CMD" "${ssh_args[@]}" "${SSH_USER}@${ip}"
