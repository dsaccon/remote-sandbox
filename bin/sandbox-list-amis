#!/usr/bin/env bash
# bin/sandbox-list-amis — list claude-sandbox-* AMIs you own.

set -euo pipefail

REPO_ROOT="${SANDBOX_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
# shellcheck source=../lib/log.sh
source "$REPO_ROOT/lib/log.sh"
# shellcheck source=../lib/config.sh
source "$REPO_ROOT/lib/config.sh"
# shellcheck source=../lib/aws.sh
source "$REPO_ROOT/lib/aws.sh"

only_active=0
case "${1:-}" in
    -h|--help)
        cat <<'EOF'
Usage: sandbox list-amis [--active]

List every claude-sandbox-* AMI you own in the configured region.
Columns: CURRENT (`yes` = the AMI in ./config, used by `sandbox up`),
ID, NAME, AGE, SIZE. Sorted newest first.

  --active   Only show AMIs in use — the one in ./config plus any AMI
             that a non-terminated sandbox is currently running. The
             complement is what `sandbox delete-ami` can safely drop.

Use `sandbox delete-ami <id>` to drop old ones (AMI + EBS snapshot).
EOF
        exit 0
        ;;
    --active)
        only_active=1
        ;;
    "")
        ;;
    *)
        die "unknown arg: $1 (try 'sandbox list-amis --help')"
        ;;
esac

config_load
aws_caller_identity

json="$(aws_describe_self_amis)"
count="$(printf '%s' "$json" | jq '.Images | length')"
if [[ "$count" -eq 0 ]]; then
    echo "no claude-sandbox-* AMIs in $AWS_REGION"
    exit 0
fi

current="${AMI_ID:-}"

# Build the "in use" set for --active: current AMI + AMIs of any
# non-terminated sandbox. Space-padded string so we can membership-test
# with a substring match (`" $id "`).
active_set=""
if [[ "$only_active" -eq 1 ]]; then
    [[ -n "$current" ]] && active_set=" $current "
    inst_json="$(aws_describe_instances_by_tag Project claude-sandbox \
        'pending,running,stopping,stopped,shutting-down')"
    while IFS= read -r ami; do
        [[ -z "$ami" || "$ami" == "null" ]] && continue
        [[ "$active_set" == *" $ami "* ]] && continue
        active_set+="$ami "
    done < <(printf '%s' "$inst_json" | jq -r '.Reservations[].Instances[].ImageId')
fi

printf '%-9s %-23s %-34s %-10s %-6s\n' CURRENT ID NAME AGE SIZE

now_epoch="$(date -u +%s)"
# Emit "no" (not "") for non-current so the first @tsv field is never empty.
# bash's `read -r` with IFS=$'\t' strips leading tabs (tab is an IFS-whitespace
# char), which would otherwise shift every column left by one for non-current
# rows. We translate "no" back to "" before printing.
printf '%s' "$json" | jq -r --arg current "$current" '
    .Images |
    sort_by(.CreationDate) | reverse |
    .[] |
    [
        (if .ImageId == $current then "yes" else "no" end),
        .ImageId,
        (.Name // "-"),
        .CreationDate,
        (((.BlockDeviceMappings // []) | map(select(.Ebs) | .Ebs.VolumeSize) | add) // 0)
    ] | @tsv
' | while IFS=$'\t' read -r mark id name created size; do
    [[ "$mark" == "no" ]] && mark=""
    if [[ "$only_active" -eq 1 && "$active_set" != *" $id "* ]]; then
        continue
    fi
    created_epoch="$(date -u -j -f "%Y-%m-%dT%H:%M:%S" "${created%.*}" "+%s" 2>/dev/null \
        || date -u -d "$created" "+%s" 2>/dev/null || echo "$now_epoch")"
    age_sec=$(( now_epoch - created_epoch ))
    if (( age_sec < 3600 )); then
        age="$(( age_sec / 60 ))m"
    elif (( age_sec < 86400 )); then
        age="$(( age_sec / 3600 ))h$(( (age_sec % 3600) / 60 ))m"
    else
        age="$(( age_sec / 86400 ))d"
    fi
    printf '%-9s %-23s %-34s %-10s %-6s\n' "$mark" "$id" "$name" "$age" "${size}G"
done
