#!/usr/bin/env bash
# bin/sandbox-list — list all Project=claude-sandbox instances.

set -euo pipefail

REPO_ROOT="${SANDBOX_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
# shellcheck source=../lib/log.sh
source "$REPO_ROOT/lib/log.sh"
# shellcheck source=../lib/config.sh
source "$REPO_ROOT/lib/config.sh"
# shellcheck source=../lib/provider.sh
source "$REPO_ROOT/lib/provider.sh"

only_active=0
case "${1:-}" in
    -h|--help)
        cat <<'EOF'
Usage: sandbox list [--active]

List every sandbox (instances tagged Project=claude-sandbox) in the
configured region, with columns: NAME, STATE, TYPE, MARKET, AGE, EXPIRES,
IP, ALLOWED.

  MARKET   "spot" if the instance is a spot instance (AWS can reclaim it at
           any time), else "on-demand".
  EXPIRES  Time until the in-VM auto-shutdown timer terminates the box.
           "off" if AUTO_SHUTDOWN_HOURS=0 at launch, "-" if launched
           before this tag existed.
  ALLOWED  CIDR the sandbox's SG lets in on :22; "-" if no rule found.

  --active   Only show ready sandboxes (running + status checks passed).
             Hides pending/initializing/stopped/terminated.
EOF
        exit 0
        ;;
    --active)
        only_active=1
        ;;
    "")
        ;;
    *)
        die "unknown arg: $1 (try 'sandbox list --help')"
        ;;
esac

config_load
provider_load
provider_check_creds

rows="$(provider_list)"
if [[ -z "$rows" ]]; then
    echo "no sandboxes in $AWS_REGION"
    exit 0
fi

# Header — STATE column widened to 14 to fit "initializing" / "shutting-down".
printf '%-22s %-14s %-18s %-10s %-10s %-8s %-16s %-18s\n' NAME STATE TYPE MARKET AGE EXPIRES IP ALLOWED

now_epoch="$(date -u +%s)"
printf '%s\n' "$rows" | while IFS=$'\t' read -r handle name state type market launch_epoch ip cidr shutdown_hours; do
    age_sec=$(( now_epoch - launch_epoch ))
    if (( age_sec < 3600 )); then
        age="$(( age_sec / 60 ))m"
    else
        age="$(( age_sec / 3600 ))h$(( (age_sec % 3600) / 60 ))m"
    fi
    if [[ "$only_active" -eq 1 && "$state" != "ready" ]]; then
        continue
    fi

    # EXPIRES: time until the in-VM auto-shutdown timer would terminate the
    # box. Computed from AutoShutdownHours tag + uptime. Negative means the
    # timer is past due (typically <5 min lag from the systemd timer).
    case "$shutdown_hours" in
        ""|"-"|"None")  expires="-" ;;
        "0")            expires="off" ;;
        *)
            threshold_sec=$(( shutdown_hours * 3600 ))
            remaining_sec=$(( threshold_sec - age_sec ))
            if (( remaining_sec <= 0 )); then
                expires="due"
            elif (( remaining_sec < 3600 )); then
                expires="$(( remaining_sec / 60 ))m"
            else
                expires="$(( remaining_sec / 3600 ))h$(( (remaining_sec % 3600) / 60 ))m"
            fi
            ;;
    esac
    printf '%-22s %-14s %-18s %-10s %-10s %-8s %-16s %-18s\n' \
        "$name" "$state" "$type" "$market" "$age" "$expires" "$ip" "$cidr"
done
