#!/usr/bin/env bash
# bin/sandbox-list — list all claude-sandbox instances across every configured
# cloud (aws + gcp), with a PROVIDER column showing which one each lives in.

set -euo pipefail

REPO_ROOT="${SANDBOX_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
# shellcheck source=../lib/log.sh
source "$REPO_ROOT/lib/log.sh"
# shellcheck source=../lib/config.sh
source "$REPO_ROOT/lib/config.sh"
# shellcheck source=../lib/provider.sh
source "$REPO_ROOT/lib/provider.sh"

only_active=0
case "${1:-}" in
    -h|--help)
        cat <<'EOF'
Usage: sandbox list [--active]

List every sandbox (Project=claude-sandbox) across ALL configured clouds —
both AWS and GCP — regardless of the active CLOUD setting. Columns: PROVIDER,
NAME, STATE, TYPE, MARKET, AGE, EXPIRES, IP, ALLOWED.

  PROVIDER "aws" or "gcp" — which cloud the box lives in. A cloud whose
           credentials aren't configured (no AWS keys / no GCP_PROJECT or
           gcloud login) is skipped silently rather than erroring.
  MARKET   "spot" for a spot/preemptible instance (the cloud can reclaim it
           at any time), else "on-demand".
  EXPIRES  Time until the box auto-terminates (AWS in-VM timer / GCP
           max-run-duration). "off" if disabled at launch, "-" if unknown.
  ALLOWED  CIDR the sandbox's firewall/SG lets in on :22; "-" if none found.

  --active   Only show ready sandboxes. Hides
             pending/initializing/stopped/terminated.

Note: up / ssh / scp / down still operate on the active CLOUD only — this
cross-cloud view applies to `list`.
EOF
        exit 0
        ;;
    --active)
        only_active=1
        ;;
    "")
        ;;
    *)
        die "unknown arg: $1 (try 'sandbox list --help')"
        ;;
esac

config_load

# emit_rows — query each cloud independently and print its normalized records,
# each prefixed with the provider name (→ 10 tab-separated fields).
#
# Each driver defines the same provider_* function names, so the two can't be
# sourced side-by-side; we load each in its own subshell. A cloud whose CLI or
# credentials aren't usable produces no rows and is skipped silently (the
# subshell always exits 0, so a creds failure never aborts the listing or trips
# the caller's `set -e`).
emit_rows() {
    local prov
    for prov in aws gcp; do
        (
            set +e
            CLOUD="$prov"
            provider_load 2>/dev/null || exit 0
            ( provider_check_creds ) >/dev/null 2>&1 || exit 0
            provider_list 2>/dev/null | while IFS= read -r row; do
                [ -n "$row" ] && printf '%s\t%s\n' "$prov" "$row"
            done
            exit 0
        )
    done
    return 0
}

rows="$(emit_rows)"
if [[ -z "$rows" ]]; then
    echo "no sandboxes (aws or gcp)"
    exit 0
fi

# Header — PROVIDER column prepended; STATE widened to 14 to fit
# "initializing" / "shutting-down".
printf '%-9s %-22s %-14s %-18s %-10s %-10s %-8s %-16s %-18s\n' \
    PROVIDER NAME STATE TYPE MARKET AGE EXPIRES IP ALLOWED

now_epoch="$(date -u +%s)"
printf '%s\n' "$rows" | while IFS=$'\t' read -r provider handle name state type market launch_epoch ip cidr shutdown_hours; do
    age_sec=$(( now_epoch - launch_epoch ))
    if (( age_sec < 3600 )); then
        age="$(( age_sec / 60 ))m"
    else
        age="$(( age_sec / 3600 ))h$(( (age_sec % 3600) / 60 ))m"
    fi
    if [[ "$only_active" -eq 1 && "$state" != "ready" ]]; then
        continue
    fi

    # EXPIRES: time until the box auto-terminates, from AutoShutdownHours + uptime.
    case "$shutdown_hours" in
        ""|"-"|"None")  expires="-" ;;
        "0")            expires="off" ;;
        *)
            threshold_sec=$(( shutdown_hours * 3600 ))
            remaining_sec=$(( threshold_sec - age_sec ))
            if (( remaining_sec <= 0 )); then
                expires="due"
            elif (( remaining_sec < 3600 )); then
                expires="$(( remaining_sec / 60 ))m"
            else
                expires="$(( remaining_sec / 3600 ))h$(( (remaining_sec % 3600) / 60 ))m"
            fi
            ;;
    esac
    printf '%-9s %-22s %-14s %-18s %-10s %-10s %-8s %-16s %-18s\n' \
        "$provider" "$name" "$state" "$type" "$market" "$age" "$expires" "$ip" "$cidr"
done
