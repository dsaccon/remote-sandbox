#!/usr/bin/env bash
# bin/sandbox-list — list claude-sandbox instances across every configured cloud
# (aws + gcp), with a PROVIDER column. --cloud narrows to one.

set -euo pipefail

REPO_ROOT="${SANDBOX_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
# shellcheck source=../lib/log.sh
source "$REPO_ROOT/lib/log.sh"
# shellcheck source=../lib/config.sh
source "$REPO_ROOT/lib/config.sh"
# shellcheck source=../lib/multicloud.sh
source "$REPO_ROOT/lib/multicloud.sh"

usage() {
    cat <<'EOF'
Usage: sandbox list [--active] [--cloud aws|gcp]

List every sandbox (Project=claude-sandbox) across ALL configured clouds — both
AWS and GCP — regardless of the config CLOUD. Columns: PROVIDER, NAME, STATE,
TYPE, DISK, MARKET, AGE, EXPIRES, IP, ALLOWED.

  PROVIDER "aws" or "gcp" — which cloud the box lives in. A cloud whose
           credentials aren't configured is skipped silently.
  MARKET   "spot" for a spot/preemptible instance, else "on-demand".
  AGE      Uptime, coarsening as it grows: "5s", "45m", "5h30m", "15d21h".
  EXPIRES  Time until the box auto-terminates, same format as AGE. "off" if
           disabled, "-" if unknown.
  ALLOWED  CIDR the sandbox's firewall/SG lets in on :22; "-" if none found.

  --active         Only show ready sandboxes.
  --cloud aws|gcp  Only show boxes in this cloud (default: both).
EOF
}

only_active=0
scope=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --active)  only_active=1; shift ;;
        --cloud)   [[ $# -ge 2 ]] || die "--cloud needs a value (aws|gcp)"
                   scope="$2"; mc_valid_cloud "$scope"; shift 2 ;;
        *)         die "unknown arg: $1 (try 'sandbox list --help')" ;;
    esac
done

config_load

rows="$(provider_list_all "$scope")"
if [[ -z "$rows" ]]; then
    if [[ -n "$scope" ]]; then echo "no sandboxes in $scope"; else echo "no sandboxes (aws or gcp)"; fi
    exit 0
fi

# Header — PROVIDER column prepended; STATE widened to 14 to fit
# "initializing" / "shutting-down".
printf '%-9s %-22s %-14s %-18s %-6s %-10s %-10s %-8s %-16s %-18s\n' \
    PROVIDER NAME STATE TYPE DISK MARKET AGE EXPIRES IP ALLOWED

# fmt_duration SECONDS — render a duration, coarsening as it grows: "5s" under a
# minute, "45m" under an hour, "5h30m" under a day, "15d21h" beyond. Minutes are
# dropped past a day because at that scale they're noise, and "381h49m" is
# unreadable as an age. The seconds tier matters for `up`: a box spends its first
# ~90s booting, which would otherwise all render as a useless "0m".
fmt_duration() {
    local s="$1"
    # Clamp negatives: AGE compares a local clock against a cloud-supplied launch
    # time, so modest skew can put a fresh box a few seconds in the future.
    # Explicit `if` rather than `(( ... )) && s=0`, which returns 1 when the
    # test is false — a footgun under `set -e` (see lib/providers/gcp.sh:200).
    if (( s < 0 )); then s=0; fi
    if (( s < 60 )); then
        printf '%ds' "$s"
    elif (( s < 3600 )); then
        printf '%dm' "$(( s / 60 ))"
    elif (( s < 86400 )); then
        printf '%dh%dm' "$(( s / 3600 ))" "$(( (s % 3600) / 60 ))"
    else
        printf '%dd%dh' "$(( s / 86400 ))" "$(( (s % 86400) / 3600 ))"
    fi
}

now_epoch="$(date -u +%s)"
# `handle` is a positional placeholder: the record's field order is fixed, so it
# has to be read even though only the other columns are rendered.
# shellcheck disable=SC2034
printf '%s\n' "$rows" | while IFS=$'\t' read -r provider handle name state type market launch_epoch ip cidr shutdown_hours disk; do
    age_sec=$(( now_epoch - launch_epoch ))
    age="$(fmt_duration "$age_sec")"
    if [[ "$only_active" -eq 1 && "$state" != "ready" ]]; then
        continue
    fi

    # EXPIRES: time until the box auto-terminates, from AutoShutdownHours + uptime.
    case "$shutdown_hours" in
        ""|"-"|"None")  expires="-" ;;
        "0")            expires="off" ;;
        *)
            threshold_sec=$(( shutdown_hours * 3600 ))
            remaining_sec=$(( threshold_sec - age_sec ))
            if (( remaining_sec <= 0 )); then
                expires="due"
            else
                expires="$(fmt_duration "$remaining_sec")"
            fi
            ;;
    esac
    case "$disk" in ""|"-"|"None") disk_disp="-" ;; *) disk_disp="${disk}G" ;; esac
    printf '%-9s %-22s %-14s %-18s %-6s %-10s %-10s %-8s %-16s %-18s\n' \
        "$provider" "$name" "$state" "$type" "$disk_disp" "$market" "$age" "$expires" "$ip" "$cidr"
done
