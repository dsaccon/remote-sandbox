# .env.example — copy to .env, fill in values, never commit.
# Loaded into your shell via:  source ./init.sh

# AWS credentials for the IAM user you created for this project.
# Both the aws CLI and ./bin/sandbox pick these up from the environment.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Default region for any aws CLI call that doesn't pass --region.
# Should match AWS_REGION in ./config.
AWS_DEFAULT_REGION=us-west-2
