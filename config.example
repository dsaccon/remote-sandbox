# config.example — copy to ./config and edit. This file is checked in;
# your ./config is gitignored.

# ---- Cloud / region ----
CLOUD="aws"                       # "aws" | "gcp"
AWS_REGION="us-west-2"            # Oregon

# ---- GCP (only used when CLOUD=gcp) ----
GCP_PROJECT=""                    # required for gcp
GCP_ZONE="us-west1-b"             # gcp is zonal; only the zone is needed
GCP_IMAGE=""                      # blank → stock ubuntu-2404-lts (bootstrap runs
                                  # at first boot, ~5-10 min); or a baked image name
GCP_MACHINE_TYPE="e2-standard-4"  # 4 vCPU / 16 GB, cost-optimized (~m7i-flex.xlarge)
GCP_SSH_PUBKEY=""                 # SSH *public* key injected at launch;
                                  # blank → ${SSH_KEY_FILE}.pub

# ---- Instance ----
INSTANCE_TYPE="m7i-flex.xlarge"   # 16 GB / 4 vCPU recommended
DISK_SIZE_GB="64"                 # root disk size (GB), both clouds; `up --disk-size` overrides
# Spot is cheaper but AWS can reclaim (terminate) the instance at any time —
# a box left idle overnight can vanish. Toggle the standing default with
# `./bin/sandbox spot on|off`, or override per launch with `up --spot` /
# `up --no-spot`. `./bin/sandbox list` shows each box's MARKET (spot/on-demand).
USE_SPOT=true
SPOT_FALLBACK_ON_DEMAND=true

# ---- Identity / access ----
SSH_KEY_NAME="claude-sandbox"     # an EC2 key pair you've already created
SSH_KEY_FILE=""                   # path to the matching local private key
                                  # blank → defaults to ~/.ssh/${SSH_KEY_NAME}.pem
SSH_USER="ubuntu"
# If cmux (https://cmux.dev) is installed and its app is running, `sandbox
# ssh` opens the session as a cmux ssh workspace instead of a plain terminal
# ssh. Set to false to always use plain ssh.
SSH_USE_CMUX=true

# ---- SSH ingress for new sandboxes ----
# Each `up` creates a per-sandbox SG with one rule: allow :22 from this CIDR.
# Blank → auto-detect your public IP via checkip.amazonaws.com (HTTPS egress).
# On split-tunnel / dual-stack networks, your HTTPS and SSH egress IPs can
# differ — in that case set this explicitly (find your SSH egress in any
# sandbox's /var/log/auth.log under "Accepted publickey from <IP>").
# Use "0.0.0.0/0" to leave SSH open to the world (convenient, less secure).
# Overridable per-launch with `sandbox up --ssh-cidr CIDR`.
SSH_INGRESS_CIDR=""

# ---- AMI ----
# Populated by `./bin/sandbox build-ami` on success.
AMI_ID=""

# ---- Lifecycle guardrails ----
# In-VM uptime timer. When the box reaches AUTO_SHUTDOWN_HOURS of uptime
# it runs `shutdown -h`, which (with InstanceInitiatedShutdownBehavior=
# terminate) terminates the instance and deletes its EBS volume —
# everything on the box is gone. The timer is uptime-based, not idle-
# based, so active use doesn't reset it. 0 disables it.
AUTO_SHUTDOWN_HOURS=0

# ---- Optional: repos cloned to ~ during AMI bake ----
DOTFILES_REPO=""                  # e.g. "https://github.com/dsaccon/dotfiles.git"
CLAUDE_HARDENING_REPO=""          # e.g. "https://github.com/dsaccon/claude-hardening.git"
                                  # Both must be publicly cloneable — the bake VM
                                  # has no GitHub credentials.
